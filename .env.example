# ARIE frontend environment configuration.
# Copy to .env.local and adjust. .env.local is gitignored; this file is not.

# "mock" (default if unset) — realistic in-memory fixtures, no backend
# required. Good for screenshots, portfolio preview, and UI work without
# Docker.
# "api" — talks to a real local ARIE backend through this app's own
# server-side proxy routes (src/app/api/arie/*), never directly from the
# browser. See README.md's "Real ARIE mode" section.
NEXT_PUBLIC_ARIE_DATA_MODE=mock

# Read server-side only, by the proxy routes, when
# NEXT_PUBLIC_ARIE_DATA_MODE=api. Not a secret — this is the backend's public
# HTTP surface, exactly what `docker compose up -d` exposes at
# http://localhost:8000 in the arie-b2b-enrichment-engine repo.
NEXT_PUBLIC_ARIE_API_BASE_URL=http://localhost:8000

# --- Supabase auth (human users, "api" mode only) ---------------------------
# Read only when NEXT_PUBLIC_ARIE_DATA_MODE=api. "mock" mode needs neither —
# it's a fabricated, client-side-only demo with no real backend and nothing
# to authenticate against, and never shows a login wall.
#
# Both values come from Supabase Dashboard -> Project Settings -> API. The
# anon/public key is meant to be public: Row Level Security on the database
# protects data behind it, not secrecy of this key. Never put
# SUPABASE_JWT_SECRET here — this app never needs it, and a NEXT_PUBLIC_
# prefix would ship it into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (deliberately no NEXT_PUBLIC_ prefix — Next.js never bundles
# this into client code, and src/lib/supabase/admin.ts is `import
# "server-only"`-guarded so a client component importing it is a build
# error). Used for exactly one lookup: a signed-in user's own
# organization_members row, after their identity is independently verified
# via their own JWT. Needed only because organization_members' RLS policies
# recurse infinitely for a plain (non-service-role) client — see
# src/lib/supabase/admin.ts's docstring. Same value the ARIE backend uses
# (Supabase Dashboard -> Project Settings -> API -> service_role).
SUPABASE_SERVICE_ROLE_KEY=

# How the backend this UI points at sources provider data: "simulated"
# (default, and the backend's own default) or "live". The backend does not
# expose its provider mode over HTTP -- /healthz returns only
# status/database/schema_ready -- so the frontend has to be told.
#
# This exists purely so cost figures are labelled honestly. Under "simulated"
# the numbers on a receipt are real ledger arithmetic over *configured*
# provider rates replayed against a frozen corpus; calling that "spend" would
# imply money someone was actually billed.
NEXT_PUBLIC_ARIE_PROVIDER_MODE=simulated
